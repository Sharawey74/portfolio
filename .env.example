# Copy to .env.local for local runs. Set the real values in the Vercel
# dashboard (Project → Settings → Environment Variables). Never commit .env*.

# Contact form (Server Action → Resend). Leave any of the three unset and the
# form is replaced by a "not connected" note; the direct links still work.
# `/` is prerendered, so set these before the build that should use them.
RESEND_API_KEY=
# Inbox that receives messages.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Portfolio <contact@your-domain>".
CONTACT_FROM_EMAIL=

# Canonical origin for metadata, sitemap, robots and JSON-LD. Optional on
# Vercel (falls back to the production domain); set it for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional. Raises the GitHub API limit for the daily open-source refresh
# (60 → 5,000 requests/hour). A fine-grained token with no scopes is enough:
# the PRs are public.
GITHUB_TOKEN=

# 1 makes `npm run build` fail while any TODO(owner) item remains. Set it on
# the Production environment only, when you are ready to launch.
LAUNCH_STRICT=

# Stage 5, default off. 1 enables the optional WebGL2 hero shader (M15).
NEXT_PUBLIC_ENABLE_SHADER=0
